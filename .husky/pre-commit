#!/bin/bash

# Pre-commit hook: Run linting and formatting checks on staged files

cd "$(git rev-parse --show-toplevel)/src/frontend"

echo "🔍 Running pre-commit checks on staged files..."

npx lint-staged --verbose

exit_code=$?

if [ $exit_code -eq 0 ]; then
  echo "✅ Pre-commit checks passed!"
else
  echo "❌ Pre-commit checks failed. Please fix the issues and try again."
  exit 1
fi
