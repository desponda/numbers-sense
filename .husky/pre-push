#!/bin/bash

# Pre-push hook: Run full CI suite before allowing push

cd "$(git rev-parse --show-toplevel)/src/frontend"

echo "🚀 Running full CI suite before push..."
echo ""

echo "📝 Checking code formatting..."
npm run format:check || { echo "❌ Formatting check failed"; exit 1; }

echo "✅ Formatting check passed"
echo ""

echo "🎨 Running ESLint..."
npm run lint || { echo "❌ Linting failed"; exit 1; }

echo "✅ Linting passed"
echo ""

echo "🔷 Running TypeScript type checking..."
npm run typecheck || { echo "❌ Type checking failed"; exit 1; }

echo "✅ Type checking passed"
echo ""

echo "🧪 Running unit tests..."
npm run test || { echo "❌ Unit tests failed"; exit 1; }

echo "✅ Unit tests passed"
echo ""

echo "⏭️  Skipping E2E tests (too slow for pre-push)"
echo "   Run manually with: npm run test:e2e"
echo ""

echo "🏗️  Building for production..."
npm run build || { echo "❌ Build failed"; exit 1; }

echo "✅ Build succeeded"
echo ""

echo "✅ All CI checks passed! Proceeding with push..."
